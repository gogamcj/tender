# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 git 에 올리지 않습니다.

# 데이터베이스. 개발: SQLite / 운영: PostgreSQL
BID_DATABASE_URL=sqlite:///./bid_analyzer.db
# BID_DATABASE_URL=postgresql+psycopg://bid:CHANGE_ME@localhost:5432/bid_analyzer

# docker compose 의 PostgreSQL 컨테이너 비밀번호
POSTGRES_PASSWORD=CHANGE_ME

# 세션 서명 키(8단계 인증 기능에서 사용). 예: python -c "import secrets;print(secrets.token_urlsafe(48))"
BID_SECRET_KEY=

# 공공데이터포털(data.go.kr) 일반 인증키(Decoding 키)
BID_DATA_GO_KR_SERVICE_KEY=

# true 면 미검증 규칙으로는 계산 자체를 거부합니다(기본: 계산은 하되 확정 결과로 표시하지 않음).
BID_BLOCK_UNVERIFIED_RULES=false
